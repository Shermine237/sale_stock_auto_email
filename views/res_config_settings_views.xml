<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sale_stock_auto_email" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.stock.auto.email</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="website_checkout_registration" position="after">
                <setting
                    id="website_auto_confirmation_sender_setting"
                    string="Website Confirmation Sender Email"
                    help="Sender email used by this module for checkout confirmation emails on this website only."
                >
                    <field name="website_auto_confirmation_email_from" placeholder="contact@yourdomain.com"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
