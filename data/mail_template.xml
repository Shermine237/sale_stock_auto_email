<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            email_from left empty on purpose: Odoo will use the company email /
            outgoing mail server (from_filter). Forcing a wrong From (e.g.
            admin@yourcompany.example.com) makes OVH accept the SMTP handoff
            while recipient servers reject/spam the message (SPF failure).
        -->
        <record id="mail_template_sale_order_confirmed" model="mail.template">
            <field name="name">Sales Order Confirmed - Auto Email</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Confirmation de commande {{ object.name }}</field>
            <field name="email_from">{{ (object.website_id and object.website_id.auto_confirmation_email_from) or object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Votre commande <strong><t t-out="object.name"/></strong> a été confirmée.</p>
    <p>Montant total : <strong><t t-out="format_amount(object.amount_total, object.currency_id)"/></strong></p>
    <p>Vous trouverez le bon de commande en pièce jointe.</p>
    <p>Merci pour votre confiance.</p>
    <p><t t-out="object.company_id.name"/></p>
</div>
            </field>
        </record>

        <record id="mail_template_picking_done" model="mail.template">
            <field name="name">Delivery Confirmed - Auto Email</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="subject">Confirmation expédition {{ object.name }}</field>
            <field name="email_from"/>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang or (object.sale_id.partner_id.lang if object.sale_id else '') }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="report_template_ids" eval="[(4, ref('stock.action_report_delivery'))]"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <p>Bonjour <t t-out="object.partner_id.name or (object.sale_id.partner_id.name if object.sale_id else '') or ''"/>,</p>
    <p>Votre commande a été expédiée.</p>
    <t t-if="object.sale_id">
        <p>Commande : <strong><t t-out="object.sale_id.name"/></strong></p>
    </t>
    <p>Référence expédition : <strong><t t-out="object.name"/></strong></p>
    <p>Vous trouverez le bon de livraison en pièce jointe.</p>
    <p>Merci.</p>
    <p><t t-out="object.company_id.name"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
